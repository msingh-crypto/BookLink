PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Public URL of this server, used in email confirmation links
SERVER_URL=http://localhost:5000

# Database (used by npm run db:init and by the app)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_db

# Full connection string. Takes priority over the DB_* values in src/config/db.js
# and is what the Jest tests use, so point it at the same database as DB_NAME.
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/your_db

# Must be exactly 64 hex characters (32 bytes). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=your_64_character_hex_key

# Gmail SMTP for confirmation emails (SMTP_PASS is a Google app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_account@gmail.com
SMTP_PASS="your app password"
MAIL_FROM="BookLink <your_account@gmail.com>"


